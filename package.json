{
  "name": "beamtalk-uat",
  "version": "0.0.0",
  "private": true,
  "description": "External acceptance gate for released Beamtalk artifacts (ADR 0154)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:harness": "playwright test --project=harness",
    "test:smoke": "playwright test --project=smoke",
    "install-toolchain": "tsx scripts/prepare-toolchain.ts",
    "uat": "npm run install-toolchain && playwright test --project=smoke",
    "resolve": "tsx scripts/resolve.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.19.0",
    "smol-toml": "1.5.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  }
}
